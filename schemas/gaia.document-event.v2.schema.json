{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaia.local/contracts/gaia.document-event.v2.schema.json",
  "title": "GAIA Document MCP untrusted operation event metadata, not authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_key",
    "operation_id",
    "event_revision",
    "source_ref",
    "source_provider",
    "source_version",
    "document_sha256",
    "derived_sha256",
    "client_id",
    "process_id",
    "operation",
    "status",
    "provider",
    "evidence_sha256",
    "summary_sha256"
  ],
  "properties": {
    "schema": {
      "const": "gaia.document-event.v2"
    },
    "event_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,80}$"
    },
    "event_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_provider": {
      "enum": [
        "drive",
        "dropbox",
        "local",
        "generated",
        "notion"
      ]
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "document_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "derived_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "client_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{3}$"
    },
    "process_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200
    },
    "operation": {
      "enum": [
        "ocr",
        "pdf_transform",
        "catalog",
        "nomenclature",
        "document_create",
        "signature",
        "workspace"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "review_required",
        "blocked",
        "failed"
      ]
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,50}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
